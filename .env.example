# Fonte de dados
# local_file é útil para desenvolvimento/homologação.
# Em operação, usar distributor_http somente após o contrato da distribuidora.
DATA_SOURCE=local_file
FILE_GDB=Energisa_SE_6587_2024-12-31_V11_20250902-1412.gdb
FILE_GEOJSON=subestacoes_logicas_aracaju.geojson
FILE_MERCADO=perfil_mercado_aracaju.json
DISTRIBUTOR_SOURCE_URL=
DISTRIBUTOR_API_TOKEN=
DATA_SOURCE_TIMEOUT_SECONDS=120
DATA_MAX_DOWNLOAD_BYTES=2147483648
DATA_MAX_ARCHIVE_ENTRIES=100000
DATA_INGEST_ON_STARTUP=false
TRAIN_MODEL_ON_STARTUP=false

# Parâmetros
CIDADE_ALVO=Aracaju, Sergipe, Brazil

# ANEEL permanece somente para validação/contingência autorizada.
ANEEL_API_HUB_URL=https://hub.arcgis.com/api/search/v1/collections/all/items
DISTRIBUIDORA_ALVO=Energisa Se

# Banco de Dados
# Substitua SUBSTITUA_A_SENHA pelo mesmo segredo nas duas URLs abaixo.
# Caracteres reservados em URLs devem ser percent-encoded.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gridscope_local
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql://postgres:SUBSTITUA_A_SENHA@localhost:5435/gridscope_local
DATABASE_URL_DOCKER=postgresql://postgres:SUBSTITUA_A_SENHA@db:5432/gridscope_local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379

# Chat IA
GEMINI_API_KEY=sua-chave-aqui
