# Fonte de dados
# local_file é útil para desenvolvimento/homologação.
# Em operação, usar distributor_http somente após o contrato da distribuidora.
DATA_SOURCE=local_file
FILE_GDB=Energisa_SE_6587_2024-12-31_V11_20250902-1412.gdb
DISTRIBUTOR_SOURCE_URL=
DISTRIBUTOR_API_TOKEN=
DATA_SOURCE_TIMEOUT_SECONDS=120
DATA_MAX_DOWNLOAD_BYTES=2147483648
DATA_MAX_ARCHIVE_ENTRIES=100000
# O banco é a fonte operacional. true mantém a leitura dos arquivos locais
# (comportamento legado) e só é útil quando nenhuma entrega foi publicada
# pelo pipeline; depois disso o banco prevalece.
ALLOW_FILE_CACHE=true
# A ingestão no boot só é forçada aqui; sem esta flag ela acontece quando o banco está vazio.
DATA_INGEST_ON_STARTUP=false
TRAIN_MODEL_ON_STARTUP=false

# Parâmetros
CIDADE_ALVO=Aracaju, Sergipe, Brazil

# ANEEL permanece somente para validação/contingência autorizada.
ANEEL_API_HUB_URL=https://hub.arcgis.com/api/search/v1/collections/all/items
DISTRIBUIDORA_ALVO=Energisa SE

# Banco de Dados
# Substitua SUBSTITUA_A_SENHA pelo mesmo segredo nas duas URLs abaixo.
# Caracteres reservados em URLs devem ser percent-encoded.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gridscope_local
POSTGRES_HOST_PORT=5435
DATABASE_SCHEMA=public
DATABASE_URL=postgresql+psycopg2://postgres:SUBSTITUA_A_SENHA@localhost:5435/gridscope_local
DATABASE_URL_DOCKER=postgresql+psycopg2://postgres:SUBSTITUA_A_SENHA@db:5432/gridscope_local
REDIS_HOST=localhost
# Porta publicada pelo Compose para processos executados no host.
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379

# Quantidade de workers por API ao executar run_all.py. Um worker evita
# repetir importacoes e rotinas de startup no ambiente de desenvolvimento.
UVICORN_WORKERS=1

# Autenticação: usuários são criados somente por administrador/bootstrap
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=gridscope_session
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT=8
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_CHAT_RATE_LIMIT=20
AUTH_CHAT_RATE_WINDOW_SECONDS=60
AUTH_ADMIN_RATE_LIMIT=30
AUTH_ADMIN_RATE_WINDOW_SECONDS=60

# Chat IA
GEMINI_API_KEY=sua-chave-aqui

# Malha municipal: informe a edição oficial adotada antes de executar o pipeline.
# O valor nomeia o diretório imutável que armazenará os artefatos e checksums.
IBGE_MALHA_REVISAO=
IBGE_MALHA_CACHE_DIR=dados/malhas_ibge
